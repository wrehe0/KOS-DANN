2026-11-13T10:01:43.462965Z	    8 Query	SELECT 'before' AS stage, SUM(price * quantity) AS total_sum
FROM orders_bad
UNION ALL
SELECT 'after',
       (SELECT SUM(p.price * oi.quantity)
        FROM order_items oi
        JOIN products p ON p.product_id = oi.product_id)
2026-11-13T10:03:23.573431Z	    8 Query	SELECT order_id, COUNT(DISTINCT rep_id) AS reps_per_order
FROM orders
GROUP BY order_id
HAVING reps_per_order > 1
2026-11-13T10:03:37.930551Z	    8 Query	SELECT r.rep_name, SUM(p.price * oi.quantity) AS total_sales
FROM representatives r
JOIN orders o       ON o.rep_id = r.rep_id
JOIN order_items oi ON oi.order_id = o.order_id
JOIN products p     ON p.product_id = oi.product_id
GROUP BY r.rep_id, r.rep_name
ORDER BY total_sales DESC
2026-11-13T10:03:48.993873Z	    8 Query	SELECT o.order_id, o.order_date, o.client_id, r.rep_name,
       p.product_name, oi.quantity, p.price
FROM orders o
JOIN representatives r ON r.rep_id = o.rep_id
JOIN order_items oi    ON oi.order_id = o.order_id
JOIN products p        ON p.product_id = oi.product_id
ORDER BY o.order_id, p.product_id
2026-11-13T10:03:52.687997Z	    8 Query	SELECT o.order_id, SUM(p.price * oi.quantity) AS order_total
FROM orders o
JOIN order_items oi ON oi.order_id = o.order_id
JOIN products p     ON p.product_id = oi.product_id
WHERE o.order_id = 7001
GROUP BY o.order_id
