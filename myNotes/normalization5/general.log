2026-11-13T10:15:03.965026Z	    8 Query	SELECT 'before' AS stage, SUM(price * quantity) AS total_sum
FROM orders_bad
UNION ALL
SELECT 'after',
       (SELECT SUM(p.price * oi.quantity)
        FROM order_items oi
        JOIN products p ON p.product_id = oi.product_id)
2026-11-13T10:15:08.629748Z	    8 Query	SELECT order_id, COUNT(DISTINCT client_id) AS clients_per_order
FROM orders
GROUP BY order_id
HAVING clients_per_order > 1
2026-11-13T10:15:13.019701Z	    8 Query	SELECT p.product_name, c.category_name
FROM products p
JOIN categories c ON c.category_id = p.category_id
ORDER BY p.product_id
2026-11-13T10:15:57.421449Z	    8 Query	SELECT c.category_name, SUM(p.price * oi.quantity) AS total_sales
FROM categories c
JOIN products p     ON p.category_id = c.category_id
JOIN order_items oi ON oi.product_id = p.product_id
GROUP BY c.category_id, c.category_name
ORDER BY total_sales DESC
2026-11-13T10:16:00.373134Z	    8 Query	SELECT o.order_id, o.order_date, cl.client_name,
       p.product_name, cat.category_name, oi.quantity, p.price
FROM orders o
JOIN clients cl     ON cl.client_id = o.client_id
JOIN order_items oi ON oi.order_id = o.order_id
JOIN products p     ON p.product_id = oi.product_id
JOIN categories cat ON cat.category_id = p.category_id
ORDER BY o.order_id, p.product_id
2026-11-13T10:16:04.151133Z	    8 Query	SELECT o.order_id, SUM(p.price * oi.quantity) AS order_total
FROM orders o
JOIN order_items oi ON oi.order_id = o.order_id
JOIN products p     ON p.product_id = oi.product_id
WHERE o.order_id = 7001
GROUP BY o.order_id
